# Michigan Unified E-Filing System - Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://muefs:muefs_dev@postgres:5432/muefs
POSTGRES_USER=muefs
POSTGRES_PASSWORD=muefs_dev
POSTGRES_DB=muefs

# Redis
REDIS_URL=redis://redis:6379/0

# S3-compatible document storage (the local stack runs Versity Gateway with these keys)
S3_ENDPOINT_URL=http://storage:7070
S3_ACCESS_KEY=muefs_storage
S3_SECRET_KEY=muefs_storage_secret
S3_BUCKET_NAME=muefs-documents

# Keycloak. KEYCLOAK_URL is the browser-facing address and the issuer tokens must name.
# The API fetches signing keys from KEYCLOAK_INTERNAL_URL when that is set.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=muefs
KEYCLOAK_CLIENT_ID=muefs-api
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Backend
DEBUG=true
# Court systems: set false in production; use Keycloak Bearer JWT only.
ALLOW_DEMO_MODE=true
# Required when ALLOW_DEMO_MODE=true and DEBUG=false. Isolated public sandboxes serve it to
# browsers through /config.js; other builds need VITE_DEMO_MODE_SECRET. Browsers receive
# this value, so it deters casual header use but is not authentication.
DEMO_MODE_SECRET=
# Hide /docs and /redoc outside DEBUG (default: follows DEBUG).
ENABLE_API_DOCS=
# Fail startup on unsafe production config (court deploys).
SECURITY_STRICT_STARTUP=false
# Reverse proxies whose X-Forwarded-For is trusted: comma-separated addresses or networks
# (CIDR), for example 10.0.0.0/8 for a platform load balancer.
TRUSTED_PROXY_IPS=
# Local dev: often true. Production: false (use IdP + admin invite).
ALLOW_PUBLIC_REGISTRATION=true
# First Bearer login creates User from token claims (requires email in token).
PROVISION_USER_ON_FIRST_OIDC_LOGIN=true
# Use redis when Redis service is available (docker-compose); memory for laptop-only API.
RATE_LIMIT_BACKEND=redis
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
# Must match backend ALLOW_DEMO_MODE for local role-picker demo (sends X-Demo-User-Id).
VITE_ALLOW_DEMO_MODE=true
# Only for builds without isolated sessions and with DEBUG=false; must then match
# DEMO_MODE_SECRET. The hosted demo reads the secret from /config.js instead, so leave
# this empty there: a build-time value is baked into the JavaScript bundle.
VITE_DEMO_MODE_SECRET=
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=muefs
VITE_KEYCLOAK_CLIENT_ID=muefs-frontend

# Document Processing
MAX_FILE_SIZE_MB=100
# Local document root for SQLite demos and restored local collections; ignored for S3.
LOCAL_STORAGE_PATH=demo_uploads

# Upload malware screening. The built-in heuristic scan (native executables + EICAR) is
# offline and always on. Enable ClamAV for real signature-based scanning in production.
MALWARE_SCAN_CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Total seconds for scanner connection, transfer and verdict. Failure always rejects the upload.
CLAMAV_TIMEOUT_SECONDS=30
# Reject uploads when libmagic cannot identify type (default: true when DEBUG=false).
STRICT_MIME_DETECTION=
# Validate JWT aud claim (default: true when DEBUG=false).
JWT_VERIFY_AUDIENCE=
JWT_AUDIENCES=
# Reject requests when Redis rate limiter is unreachable (default: true when DEBUG=false).
RATE_LIMIT_FAIL_CLOSED=

# Enable only after the court approves external receipt verification and credit corrections.
EXTERNAL_PAYMENTS_ENABLED=false
# No payment processor is integrated. false removes the demo payment path; it does not
# connect one.
PAYMENTS_ARE_SIMULATED=true

# Filing notice email. Disabled by default; configure both API and notice worker.
EMAIL_DELIVERY_ENABLED=false
# Separately opt in to selected document delivery after court workflow evaluation.
SERVICE_DELIVERY_ENABLED=false
PORTAL_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
