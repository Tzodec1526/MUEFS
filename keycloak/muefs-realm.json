{
  "realm": "muefs",
  "displayName": "MUEFS local evaluation",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "muefs-frontend",
      "name": "MUEFS portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login"
      },
      "defaultClientScopes": ["basic", "profile", "email"],
      "protocolMappers": [
        {
          "name": "MUEFS API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "muefs-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "muefs-api",
      "name": "MUEFS API",
      "enabled": true,
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "local-litigant",
      "email": "local-litigant@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Local",
      "lastName": "Litigant",
      "credentials": [
        { "type": "password", "value": "local-evaluation-only", "temporary": false }
      ]
    }
  ]
}
