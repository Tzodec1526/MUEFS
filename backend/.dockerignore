# Compose builds this directory directly, so the repository root's .dockerignore does not
# apply. Keep local environments, data, caches and draft work product out of images.
.venv*/
**/__pycache__
**/*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
*.db
*.db-*
demo_data/
demo_uploads/
.env*
app/data/
